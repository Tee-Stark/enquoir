# Airwallex sandbox credentials. Never point AWX_BASE_URL anywhere but the
# sandbox: the app refuses to start otherwise.
AWX_BASE_URL=https://api.sandbox.airwallex.com
AWX_CLIENT_ID=
AWX_API_KEY=

# Postgres, used by both the app and (via separate databases) Temporal.
# Host port defaults to 5433, not 5432, to avoid colliding with a
# native/Homebrew Postgres that may already be running on this machine.
POSTGRES_USER=enquoir
POSTGRES_PASSWORD=enquoir
POSTGRES_DB=enquoir
POSTGRES_PORT=5433
DATABASE_URL=postgres://enquoir:enquoir@localhost:5433/enquoir?sslmode=disable

# Temporal dev server.
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_UI_PORT=8088

# Policy: the most a payment workflow will authorize before blocking
# it instead. Optional - cmd/demo and cmd/api default to effectively
# no limit.
MAX_PAYMENT_MINOR_UNITS=100000000

# cmd/api's listen address. Optional - defaults to :8090, not :8080,
# since something else is often already on :8080 (and even :8081) on
# a dev machine.
HTTP_ADDR=:8090

# Dashboard session cookie. Keep SESSION_COOKIE_SECURE=true anywhere
# served over HTTPS; false only for plain-HTTP local development, where
# a Secure cookie would be dropped. SESSION_TTL is a Go duration.
SESSION_COOKIE_SECURE=false
SESSION_TTL=168h

# Browser origins of dashboard frontends allowed to call the API with the
# session cookie, comma-separated (scheme://host[:port]). A state-changing
# request a browser sends from any other origin is refused (403).
CORS_ALLOWED_ORIGINS=http://localhost:3000
